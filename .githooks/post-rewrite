#!/bin/sh
# Rebuild configs after pulling.
root="$(git rev-parse --show-toplevel)"
[ -f "$root/yasb/machine.yaml" ] || { echo "dotfiles: no yasb/machine.yaml, skipping build"; exit 0; }
powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$root/build.ps1" || echo "dotfiles: build.ps1 failed"
exit 0
